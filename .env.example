# Token de solo lectura para listar y sincronizar repositorios GitLab (obligatoria).
GITLAB_TOKEN=
# URL del servidor GitLab institucional (obligatoria para sincronizar el catálogo).
GITLAB_URL=https://gitlab.dominio.com
# 0 valida TLS; 1 omite la validación y solo debe usarse por una exigencia del proxy corporativo (opcional, recomendado: 0).
GITLAB_INSECURE=0

# up-prod.ps1 genera y guarda una clave aleatoria si este marcador sigue presente.
# Conserva la misma clave entre reinicios para mantener válidas las sesiones.
DJANGO_SECRET_KEY=REEMPLAZAR_POR_CADENA_ALEATORIA_Y_SEGURA_DE_50_CARACTERES
# Activa el modo de depuración de Django; debe ser false en producción (opcional, recomendado: false).
DJANGO_DEBUG=false
# Hosts permitidos por Django, separados por comas (obligatoria en producción).
DJANGO_ALLOWED_HOSTS=192.x.x.x,backend
# Orígenes web externos permitidos por CORS, separados por comas.
# Déjalo vacío cuando la UI se sirve desde el backend Docker en el mismo origen.
CORS_ALLOWED_ORIGINS=

# URL de conexión a PostgreSQL del dashboard (obligatoria).
DATABASE_URL=postgres://dashboard:dashboard-password@db:5432/dashboard_db
# URL de Redis para Celery y la caché del catálogo (opcional; por defecto redis://redis:6379/0).
REDIS_URL=redis://redis:6379/0
# Puertos locales publicados por docker-compose.prod (opcionales; se muestran aquí para evitar usar puertos comunes).
BACKEND_PORT=8011
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
# Host y puerto del almacenamiento S3-compatible MinIO (opcional; por defecto minio:9000).
MINIO_ENDPOINT=minio:9000
# Usuario de acceso al bucket de MinIO (obligatoria si se guardan artefactos).
MINIO_ACCESS_KEY=REEMPLAZAR_POR_USUARIO_MINIO
# Clave de acceso al bucket de MinIO (obligatoria si se guardan artefactos).
MINIO_SECRET_KEY=REEMPLAZAR_POR_CLAVE_MINIO
# Usa HTTPS para MinIO cuando vale true; false para HTTP local (opcional; por defecto false).
MINIO_SECURE=false

# Host de Oracle (obligatoria para comparación o auditoría Oracle).
ORACLE_HOST=HOST_ORACLE
# Puerto TCP de Oracle (obligatoria para comparación o auditoría Oracle).
ORACLE_PORT=1521
# Nombre del servicio Oracle (obligatoria para comparación o auditoría Oracle).
ORACLE_SERVICE_NAME=SERVICIO_ORACLE
# Cuenta Oracle estándar de solo lectura usada por el dashboard (obligatoria para Oracle estándar).
ORACLE_USER=REEMPLAZAR_POR_USUARIO_ORACLE_ESTANDAR
# Clave de la cuenta Oracle estándar (obligatoria para Oracle estándar).
ORACLE_PASSWORD=REEMPLAZAR_POR_CLAVE_ORACLE

# Ruta local opcional al PEM de la CA raíz para builds detrás de inspección TLS; vacía normalmente.
BUILD_CA_CERT_FILE=
